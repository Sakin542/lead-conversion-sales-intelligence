{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/storage/**": true,
    "**/dist/**": true,
    "**/__pycache__/**": true,
    "**/.system_generated/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/dist": true,
    "**/storage": true
  },
  "git.autorefresh": true,
  "git.autoStash": true,
  "git.decorations.enabled": true,
  "git.openRepositoryInParentFolders": "always"
}
