APP_NAME="Predictive Lead Scoring CRM"
APP_ENV=local
APP_KEY=base64:7qvlrIGXdfiv4rV6ARSdIjCFXZsoflbR01A8AV64234=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# ==========================================
# DATABASE - MYSQL
# ==========================================

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=predictive_crm
DB_USERNAME=crm_user
DB_PASSWORD=crm_password


# ==========================================
# SESSION
# ==========================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# ==========================================
# CACHE
# ==========================================

CACHE_STORE=database


# ==========================================
# QUEUE
# ==========================================

QUEUE_CONNECTION=database


# ==========================================
# REDIS
# ==========================================

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379


# ==========================================
# BROADCASTING
# ==========================================

BROADCAST_CONNECTION=log


# ==========================================
# FILESYSTEM
# ==========================================

FILESYSTEM_DISK=local


# ==========================================
# MAIL
# ==========================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# ==========================================
# VITE
# ==========================================

VITE_APP_NAME="${APP_NAME}"


# ==========================================
# SANCTUM
# ==========================================

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1


# ==========================================
# ML SERVICE
# ==========================================

ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_TIMEOUT=30


# ==========================================
# LEAD SCORING
# ==========================================

LEAD_SCORING_ENABLED=true
LEAD_SCORING_BATCH_SIZE=100


# ==========================================
# HORIZON
# ==========================================

HORIZON_PREFIX=predictive_crm_horizon